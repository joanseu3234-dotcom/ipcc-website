{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/cases-gov.html",
      "destination": "/cases-cx.html",
      "permanent": true
    },
    {
      "source": "/services-training.html",
      "destination": "/services/ai-training",
      "permanent": true
    },
    {
      "source": "/services-training",
      "destination": "/services/ai-training",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services/:slug",
      "destination": "/service-detail.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/insight-detail.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        }
      ]
    },
    {
      "source": "/content-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        }
      ]
    }
  ]
}
